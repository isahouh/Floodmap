[CONTROLS]
RULE NWWF_OFF
IF PUMP Channel FLOW >= 145
OR PUMP SEP_outflow FLOW >= 172
THEN PUMP Northshore STATUS = OFF
PRIORITY 1
RULE NWWF_ON
IF PUMP Channel FLOW <= 140
OR PUMP SEP_outflow FLOW <= 168
THEN PUMP Northshore STATUS = ON
PRIORITY 2
RULE NPF_ON
IF CONDUIT Jackson FLOW > 8
OR CONDUIT Marina-1 FLOW > 10
OR CONDUIT NorthBeach-4_5 FLOW > 50
THEN PUMP NWWF STATUS = ON
PRIORITY 3
RULE NPF_OFF
IF CONDUIT Jackson FLOW < 4
AND CONDUIT Marina-1 FLOW < 6
AND CONDUIT NorthBeach-4_5 FLOW < 45
THEN PUMP NWWF STATUS = OFF
PRIORITY 4
RULE EffluentCTRL_OPEN
IF PUMP SEP_outflow FLOW >= 165
THEN CONDUIT C41 STATUS = OPEN
ELSE CONDUIT C41 STATUS = CLOSED
PRIORITY 7
RULE Bruce_ON
IF GAGE Raingage_py INTENSITY >= 0.25
OR PUMP SEP_inf FLOW >= 100
THEN PUMP Bruceflynn STATUS = ON
PRIORITY 9
RULE Bruce_OFF
IF NODE J26 DEPTH < 20
AND GAGE Raingage_py INTENSITY < 0.25
THEN PUMP Bruceflynn STATUS = OFF
PRIORITY 10
RULE Grif_WW
IF NODE J48 DEPTH >= 4
THEN PUMP GriffithWW STATUS = ON
PRIORITY 11
RULE SDS1
IF NODE  J77 DEPTH > 20
THEN PUMP Sunnyd STATUS = ON
ELSE PUMP Sunnyd STATUS = OFF
RULE Grif_Off
IF PUMP GriffithWW STATUS = ON
OR PUMP GriffithWW FLOW < 3
THEN PUMP Griffith STATUS = OFF
ELSE PUMP Griffith STATUS = ON

